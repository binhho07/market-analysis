# Database (Prisma Postgres, Neon, or any PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Google Maps (enable Maps JavaScript, Places, and Geocoding APIs)
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Auth
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Website discovery
BRAVE_SEARCH_API_KEY=""

# Optional cache, rate limiting, and analysis queue
REDIS_URL="redis://127.0.0.1:6379"

# Watchlist crawler. Set to false to keep the scheduler off.
MONITOR_CRON="true"

# Grounded AI insights (optional — without this, insights use deterministic summaries only)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
