# Database (Prisma Postgres, Neon, or any PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Google Maps (enable Maps JavaScript, Places, and Geocoding APIs)
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Auth
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Website discovery
BRAVE_SEARCH_API_KEY=""

# Optional cache, rate limiting, and analysis queue
REDIS_URL="redis://127.0.0.1:6379"
